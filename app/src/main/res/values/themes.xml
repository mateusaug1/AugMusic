<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base clara; a versão noturna (values-night) usa o tema escuro do Android.
         As cores reais do app vêm do Compose (Theme.kt) conforme a escolha do usuário. -->
    <style name="Theme.WMusic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/wmusic_window</item>
        <item name="android:colorBackground">@color/wmusic_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
